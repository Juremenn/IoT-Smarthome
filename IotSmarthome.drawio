        </mxCell>
        <mxCell id="A04" value="Read Digital Signal from&lt;br/&gt;Flame Sensor D34 (Every 5 ms)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
