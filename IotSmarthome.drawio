        </mxCell>
        <mxCell id="F1_S" value="5-Way Flame Sensor (GPIO D34) -&amp;gt; Immediate Door Servo Open (0°) -&amp;gt; OLED Alert &amp;amp; Web Alarm (/alarm.mp3)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=11;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
