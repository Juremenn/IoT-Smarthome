        <mxCell id="A03" value="Toggle Polarity&lt;br/&gt;via Web?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=10.5;fontColor=#000000;spacing=6;" vertex="1" parent="1">
